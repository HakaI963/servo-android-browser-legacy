<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark is the default. Compose supplies the full Material 3 scheme at runtime. -->
    <style name="Theme.ServoBrowser" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/ink_950</item>
        <item name="android:navigationBarColor">@color/ink_950</item>
        <item name="android:windowBackground">@color/ink_950</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
